    "required": ["stepOneHeading", "programTiles", "stepTwoFields"],
    "additionalProperties": false
  },
  "constraints": { "onePerPage": true, "repeatable": false, "routeRestriction": "/why-playground" },
  "motion": {
    "pattern": "accordion-reveal",
