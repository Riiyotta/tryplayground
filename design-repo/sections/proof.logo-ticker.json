  },
  "constraints": { "onePerPage": true, "notRecommendedWith": ["collection.card-grid", "collection.category-feed", "collection.release-feed"], "repeatable": false },
  "motion": {
    "pattern": "logo-marquee",
    "speedPxPerSec": 49.7,
    "reducedMotionFallback": "static row of logos, no marquee translateX loop"
  }
}
